# Supabaseプロジェクトの Settings > API から取得してください
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------
# ⚠️ デプロイ前チェックリスト（課題1でVercelの環境変数登録漏れがあったため）
#
# 1. このファイルをコピーして .env.local を作成し、値を埋めてローカルで動作確認する
# 2. Vercelにデプロイする場合は、上記2つの変数を
#    Vercel Dashboard > Project > Settings > Environment Variables に
#    「Production」「Preview」「Development」すべてにチェックを入れて登録する
# 3. 登録後、Vercel側で Redeploy しないと環境変数は反映されないので注意する
# ------------------------------------------------------------------
